{
  "name": "youtube-analytics",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:web && wrangler dev --port 8791",
    "preview": "pnpm build:web && wrangler dev",
    "dev:web": "vite",
    "build": "pnpm build:web && wrangler deploy --dry-run --outdir dist/worker",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:repo": "python3 scripts/validate-repository-consistency.py",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:release:deploy": "node scripts/check-release-readiness.mjs --deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:skill": "node scripts/skill-analysis/check-no-causal-language.mjs && node scripts/skill-analysis/check-rds-unmodified.mjs && node scripts/skill-analysis/run-yt-analyze-fixture.mjs tests/fixtures/skill-analysis-sample --with-stub && (node scripts/skill-analysis/run-yt-analyze-fixture.mjs tests/fixtures/skill-analysis-sample --with-stub=403; test $? -eq 4)",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.136.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4"
    }
  }
}
